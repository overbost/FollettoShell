#!/bin/sh
set -e

FOLLETTO_PREFIX=/opt/folletto

compile_schemas() {
  dir=$1
  if [ -d "$dir" ] && command -v glib-compile-schemas >/dev/null 2>&1; then
    glib-compile-schemas "$dir" || true
  fi
}

case "$1" in
  configure)
    compile_schemas "$FOLLETTO_PREFIX/share/glib-2.0/schemas"
    compile_schemas /usr/share/glib-2.0/schemas
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database -q /usr/share/applications || true
    fi
    # Assicura path corretti nelle unit systemd del prefix (rebuild da path di build).
    if [ -d "$FOLLETTO_PREFIX/lib/systemd/user" ]; then
      find "$FOLLETTO_PREFIX/lib/systemd/user" -type f \( -name '*.service' -o -name '*.target' \) \
        -exec sed -i \
          -e "s|/var/tmp/folletto/prefix|$FOLLETTO_PREFIX|g" \
          -e "s|ExecStart=$FOLLETTO_PREFIX/bin/gnome-shell|ExecStart=/usr/bin/folletto-gnome-shell|g" \
          {} + 2>/dev/null || true
    fi
    if [ -f "$FOLLETTO_PREFIX/share/applications/org.gnome.Shell.desktop" ]; then
      sed -i 's|^Exec=.*|Exec=/usr/bin/folletto-gnome-shell|' \
        "$FOLLETTO_PREFIX/share/applications/org.gnome.Shell.desktop" 2>/dev/null || true
    fi
    cat >&2 <<'EOF'
Folletto: sessioni «Folletto» / «Folletto on Xorg» registrate.
Se GDM si era bloccato con un pacchetto precedente, riavvia gdm3 (o il PC)
e controlla i log in ~/.local/state/folletto/ in caso di schermo nero.
EOF
    ;;
esac

exit 0
