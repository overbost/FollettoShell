<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.folletto.wm" path="/org/folletto/wm/">
    <key name="mode" type="s">
      <default>'normal'</default>
      <summary>Window manager mode</summary>
      <description>normal = GNOME 48 behaviour; i3 = tiling by default</description>
    </key>
    <key name="show-decorations" type="b">
      <default>false</default>
      <summary>Show window decorations in tiling mode</summary>
      <description>If false, tiled windows have no frame/shadow/titlebar chrome. Floating windows are unchanged.</description>
    </key>
    <key name="gaps-inner" type="i">
      <default>4</default>
      <summary>Inner gap between tiled windows</summary>
    </key>
    <key name="gaps-outer" type="i">
      <default>4</default>
      <summary>Outer gap around the workspace</summary>
    </key>
    <key name="default-layout" type="s">
      <default>'splith'</default>
      <summary>Default split layout for new containers</summary>
      <description>splith, splitv, tabbed or stacked</description>
    </key>
    <key name="toggle-mode" type="as">
      <default><![CDATA[['<Super><Shift>t']]]></default>
      <summary>Toggle i3 / normal mode</summary>
    </key>
    <key name="focus-left" type="as">
      <default><![CDATA[['<Super>h']]]></default>
      <summary>Focus left</summary>
    </key>
    <key name="focus-right" type="as">
      <default><![CDATA[['<Super>l']]]></default>
      <summary>Focus right</summary>
    </key>
    <key name="focus-up" type="as">
      <default><![CDATA[['<Super>k']]]></default>
      <summary>Focus up</summary>
    </key>
    <key name="focus-down" type="as">
      <default><![CDATA[['<Super>j']]]></default>
      <summary>Focus down</summary>
    </key>
    <key name="move-left" type="as">
      <default><![CDATA[['<Super><Shift>h']]]></default>
      <summary>Move left</summary>
    </key>
    <key name="move-right" type="as">
      <default><![CDATA[['<Super><Shift>l']]]></default>
      <summary>Move right</summary>
    </key>
    <key name="move-up" type="as">
      <default><![CDATA[['<Super><Shift>k']]]></default>
      <summary>Move up</summary>
    </key>
    <key name="move-down" type="as">
      <default><![CDATA[['<Super><Shift>j']]]></default>
      <summary>Move down</summary>
    </key>
    <key name="split-h" type="as">
      <default><![CDATA[['<Super>b']]]></default>
      <summary>Split horizontal</summary>
    </key>
    <key name="split-v" type="as">
      <default><![CDATA[['<Super>v']]]></default>
      <summary>Split vertical</summary>
    </key>
    <key name="layout-tabbed" type="as">
      <default><![CDATA[['<Super>w']]]></default>
      <summary>Tabbed layout</summary>
    </key>
    <key name="layout-stacked" type="as">
      <default><![CDATA[['<Super>s']]]></default>
      <summary>Stacked layout</summary>
    </key>
    <key name="layout-splith" type="as">
      <default><![CDATA[['<Super><Shift>e']]]></default>
      <summary>Horizontal tiling layout</summary>
    </key>
    <key name="layout-splitv" type="as">
      <default><![CDATA[['<Super><Ctrl>e']]]></default>
      <summary>Vertical tiling layout</summary>
    </key>
    <key name="layout-toggle-split" type="as">
