#!/usr/bin/env python3
"""Pannello Impostazioni Folletto (Adwaita), analogo a una pagina di GNOME Impostazioni."""

import re

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, Gtk, GLib


MOD_CHOICES = ["Super", "Alt", "Ctrl"]
LAYOUT_KEYS = ["grid", "niri", "splith", "splitv", "tabbed", "stacked"]
SHORTCUT_KEYS = [
    "toggle-mode",
    "focus-left",
    "focus-right",
    "focus-up",
    "focus-down",
    "move-left",
    "move-right",
    "move-up",
    "move-down",
    "split-h",
    "split-v",
    "layout-grid",
    "layout-niri",
    "scroll-left",
    "scroll-right",
    "layout-tabbed",
    "layout-stacked",
    "layout-splith",
    "layout-splitv",
    "layout-toggle-split",
    "floating-toggle",
    "fullscreen",
    "kill",
    "scratchpad-move",
    "scratchpad-show",
    "mode-resize",
    "resize-grow-width",
    "resize-shrink-width",
    "workspace-1",
    "workspace-2",
    "workspace-3",
    "workspace-4",
    "workspace-5",
    "workspace-6",
    "workspace-7",
    "workspace-8",
    "workspace-9",
    "workspace-10",
    "move-workspace-1",
    "move-workspace-2",
    "move-workspace-3",
    "move-workspace-4",
    "move-workspace-5",
    "move-workspace-6",
    "move-workspace-7",
    "move-workspace-8",
    "move-workspace-9",
    "move-workspace-10",
]


def _rewrite_mod(accel: str, old: str, new: str) -> str:
    if old == new:
        return accel
    return accel.replace(f"<{old}>", f"<{new}>")


class FollettoSettings(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="org.folletto.Settings",
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )
        self.settings = Gio.Settings.new("org.folletto.wm")
        self._mod_updating = False

    def do_activate(self):
        win = self.props.active_window
        if win:
            win.present()
            return

        win = Adw.ApplicationWindow(application=self)
        win.set_title("Folletto")
        win.set_default_size(640, 680)

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        header.set_title_widget(Adw.WindowTitle(title="Folletto", subtitle="Tiling i3"))
        toolbar.add_top_bar(header)

        prefs = Adw.PreferencesPage(title="Tiling")
        prefs.set_icon_name("view-grid-symbolic")

        mode = Adw.PreferencesGroup(
            title="Modalità",
            description="Passa tra il comportamento GNOME 48 e il tiling i3 senza uscire dalla sessione.",
        )
        i3_row = Adw.SwitchRow(
            title="Modalità i3",
            subtitle="Le nuove finestre vengono affiancate. Floating solo come eccezione.",
        )
        i3_row.set_active(self.settings.get_string("mode") == "i3")
        i3_row.connect("notify::active", self._on_mode)
        mode.add(i3_row)

        deco_row = Adw.SwitchRow(
            title="Mostra cornici",
            subtitle="Barra del titolo e ombre sulle finestre affiancate. Disattivo = stile i3 (border none).",
        )
        self.settings.bind(
            "show-decorations", deco_row, "active", Gio.SettingsBindFlags.DEFAULT
        )
        mode.add(deco_row)
        prefs.add(mode)

        layout = Adw.PreferencesGroup(
            title="Layout predefinito",
            description="Griglia (default): split automatici H/V. Niri: strip orizzontale scrollabile, finestre a metà schermo. Tabbed/stacked come in i3.",
        )
        combo = Gtk.StringList.new(
            [
                "grid — griglia automatica",
                "niri — strip scrollabile",
                "splith — tiling orizzontale",
                "splitv — tiling verticale",
                "tabbed — schede in riga",
                "stacked — titoli in colonna",
            ]
        )
        layout_row = Adw.ComboRow(title="Nuove finestre", model=combo)
        current = self.settings.get_string("default-layout")
        if current in LAYOUT_KEYS:
            layout_row.set_selected(LAYOUT_KEYS.index(current))
        else:
            layout_row.set_selected(0)
        layout_row.connect(
            "notify::selected",
            lambda row, *_: self.settings.set_string(
                "default-layout", LAYOUT_KEYS[row.get_selected()]
            ),
        )
        layout.add(layout_row)
        prefs.add(layout)

        gaps = Adw.PreferencesGroup(title="Spaziature")
        inner = Adw.SpinRow(
            title="Gap interno",
            subtitle="Pixel tra una cella e l’altra",
            adjustment=Gtk.Adjustment(
                lower=0, upper=64, step_increment=1, page_increment=4, value=4
            ),
        )
        self.settings.bind("gaps-inner", inner, "value", Gio.SettingsBindFlags.DEFAULT)
        outer = Adw.SpinRow(
            title="Gap esterno",
            subtitle="Pixel intorno al workspace",
            adjustment=Gtk.Adjustment(
                lower=0, upper=64, step_increment=1, page_increment=4, value=4
            ),
        )
        self.settings.bind("gaps-outer", outer, "value", Gio.SettingsBindFlags.DEFAULT)
        gaps.add(inner)
        gaps.add(outer)
        prefs.add(gaps)

        focus = Adw.PreferencesGroup(
            title="Bordo focus",
            description="Evidenzia la finestra attiva con un contorno colorato.",
        )
        border_on = Adw.SwitchRow(
            title="Mostra bordo focus",
            subtitle="Contorno intorno alla finestra con il focus in modalità i3.",
        )
        self.settings.bind(
            "focus-border-enabled", border_on, "active", Gio.SettingsBindFlags.DEFAULT
        )
        focus.add(border_on)

        width = Adw.SpinRow(
            title="Spessore",
            subtitle="Pixel del bordo",
            adjustment=Gtk.Adjustment(
                lower=0, upper=16, step_increment=1, page_increment=2, value=3
            ),
        )
        self.settings.bind(
            "focus-border-width", width, "value", Gio.SettingsBindFlags.DEFAULT
        )
        focus.add(width)

        color_row = Adw.ActionRow(
            title="Colore",
            subtitle="Es. #3584e4 oppure rgb(53,132,228)",
        )
        color_entry = Gtk.Entry(
            text=self.settings.get_string("focus-border-color"),
            width_chars=14,
            max_width_chars=18,
            valign=Gtk.Align.CENTER,
        )
        color_entry.connect("changed", self._on_border_color)
        color_row.add_suffix(color_entry)
        focus.add(color_row)
        prefs.add(focus)

        keys_group = Adw.PreferencesGroup(
            title="Tastiera",
            description="Il modificatore principale (di solito Super / tasto Windows) si applica a tutte le scorciatoie Folletto.",
        )
        mod_combo = Gtk.StringList.new(MOD_CHOICES)
        mod_row = Adw.ComboRow(
            title="Tasto modificatore",
            subtitle="Super = tasto Windows/⌘. Alt o Ctrl in alternativa.",
            model=mod_combo,
        )
        current_mod = self.settings.get_string("mod-key")
        if current_mod not in MOD_CHOICES:
            current_mod = self._detect_mod()
            self.settings.set_string("mod-key", current_mod)
        mod_row.set_selected(MOD_CHOICES.index(current_mod))
        mod_row.connect("notify::selected", self._on_mod_changed)
        keys_group.add(mod_row)

        open_keys = Adw.ButtonRow(title="Apri scorciatoie da tastiera")
        open_keys.connect("activated", self._open_keyboard)
        keys_group.add(open_keys)
        prefs.add(keys_group)

        help_group = Adw.PreferencesGroup(title="Layout i3")
        help_group.add(
            Adw.ActionRow(
                title="Griglia",
                subtitle="Ricostruisce le finestre: 1ª a schermo intero; 2ª a metà; poi split verticali/orizzontali alternati.",
            )
        )
        help_group.add(
            Adw.ActionRow(
                title="Niri",
                subtitle="Colonne su strip infinito. Rotella del mouse o swipe a 3 dita per scorrere.",
            )
        )
        help_group.add(
            Adw.ActionRow(
                title="Tabbed",
                subtitle="Una riga di schede con i nomi delle finestre; quella in focus è evidenziata.",
            )
        )
        help_group.add(
            Adw.ActionRow(
                title="Stacked",
                subtitle="I titoli sono uno sotto l’altro; sotto resta il contenuto della finestra attiva.",
            )
        )
        prefs.add(help_group)

        toolbar.set_content(prefs)
        win.set_content(toolbar)
        win.present()

    def _detect_mod(self) -> str:
        try:
            sample = self.settings.get_strv("focus-left")
        except GLib.Error:
            return "Super"
        blob = " ".join(sample)
        for mod in MOD_CHOICES:
            if f"<{mod}>" in blob:
                return mod
        return "Super"

    def _on_mode(self, row, _pspec):
        self.settings.set_string("mode", "i3" if row.get_active() else "normal")

    def _on_border_color(self, entry):
        text = entry.get_text().strip()
        if not text:
            return
        if not re.match(r"^(#[0-9A-Fa-f]{3,8}|rgb[a]?\([^)]+\)|[a-zA-Z]+)$", text):
            return
        self.settings.set_string("focus-border-color", text)

    def _on_mod_changed(self, row, _pspec):
        if self._mod_updating:
            return
        idx = row.get_selected()
        if idx < 0 or idx >= len(MOD_CHOICES):
            return
        new_mod = MOD_CHOICES[idx]
        old_mod = self.settings.get_string("mod-key")
        if old_mod not in MOD_CHOICES:
            old_mod = self._detect_mod()
        if old_mod == new_mod:
            self.settings.set_string("mod-key", new_mod)
            return

        self._mod_updating = True
        try:
            for key in SHORTCUT_KEYS:
                try:
                    vals = self.settings.get_strv(key)
                except GLib.Error:
                    continue
                rewritten = [_rewrite_mod(v, old_mod, new_mod) for v in vals]
                if rewritten != vals:
                    self.settings.set_strv(key, rewritten)
            self.settings.set_string("mod-key", new_mod)
        finally:
            self._mod_updating = False

    def _open_keyboard(self, _row):
        try:
            Gio.Subprocess.new(
                ["gnome-control-center", "keyboard"], Gio.SubprocessFlags.NONE
            )
        except GLib.Error:
            pass


if __name__ == "__main__":
    Adw.init()
    app = FollettoSettings()
    raise SystemExit(app.run())
