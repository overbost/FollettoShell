#!/bin/sh
# Wrapper sessione Folletto Wayland (GDM / display manager).
set -eu
_folletto_lib=
for _c in \
  "${FOLLETTO_PREFIX:-/opt/folletto}/libexec/folletto-session-lib.sh" \
  /usr/libexec/folletto/folletto-session-lib.sh \
  "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/folletto-session-lib.sh"
do
  if [ -f "$_c" ]; then
    _folletto_lib=$_c
    break
  fi
done
[ -n "$_folletto_lib" ] || {
  echo "folletto-session-lib.sh non trovato." >&2
  exit 1
}
# shellcheck source=folletto-session-lib.sh
. "$_folletto_lib"
folletto_setup_prefix
folletto_disable_extensions_on_first_run
export XDG_SESSION_TYPE=wayland

# --builtin: non usare le unit systemd di sistema (org.gnome.Shell → /usr/bin/gnome-shell).
# Altrimenti GDM lancia lo shell Debian con LD_LIBRARY_PATH Folletto e si blocca.
if [ -n "${FOLLETTO_SESSION_LOG:-}" ]; then
  echo "exec gnome-session --session=folletto --builtin $*" >>"$FOLLETTO_SESSION_LOG"
  exec gnome-session --session=folletto --builtin "$@" >>"$FOLLETTO_SESSION_LOG" 2>&1
fi
exec gnome-session --session=folletto --builtin "$@"
