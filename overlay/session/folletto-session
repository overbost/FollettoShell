#!/bin/sh
# Wrapper sessione Folletto Wayland (GDM / display manager).
set -eu
_folletto_lib=
for _c in \
  "${FOLLETTO_PREFIX:-/opt/folletto}/libexec/folletto-session-lib.sh" \
  /usr/libexec/folletto/folletto-session-lib.sh \
  "$(CDPATH= cd -- "$(dirname "$0")" && pwd)/folletto-session-lib.sh"
do
  if [ -f "$_c" ]; then
    _folletto_lib=$_c
    break
  fi
done
[ -n "$_folletto_lib" ] || {
  echo "folletto-session-lib.sh non trovato." >&2
  exit 1
}
# shellcheck source=folletto-session-lib.sh
. "$_folletto_lib"
folletto_setup_prefix
folletto_warn_schema_missing
folletto_disable_extensions_on_first_run
export XDG_SESSION_TYPE=wayland

# Systemd + org.folletto.Shell (vedi usr/lib/systemd/user/), come GNOME stock.
# Non reindirizzare stdout di gnome-session: GDM attende la registrazione sessione.
{
  echo "exec gnome-session --session=folletto $*"
} >>"${FOLLETTO_SESSION_LOG:-/dev/null}" 2>&1 || true
exec gnome-session --session=folletto "$@"
